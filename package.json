{
  "name": "price-tracker",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "services:up": "docker compose up -d --wait postgres redis",
    "services:down": "docker compose down",
    "db:migrate": "npm run migrate -w @pricetracker/api"
  },
  "devDependencies": {
    "turbo": "^2.11.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
