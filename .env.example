# Copy to .env (or run `npm run setup`, which generates secrets for you).
# Every variable here is read by apps/api (server + worker). Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://pricetracker:pricetracker@localhost:5433/pricetracker
REDIS_URL=redis://localhost:6379
# Random string, at least 32 characters. `npm run setup` generates one.
JWT_SECRET=
# Comma-separated origins allowed to call the API from a browser. Not needed in
# development (Vite proxies /api) or when the API serves the web app itself.
CORS_ORIGINS=

# --- Price sources (each one is optional; missing keys just disable that source) ---

# RapidAPI key. Used for:
#   - Amazon, via the "Price Analytics" API (rapidapi.com/3b-data-3b-data-default/api/price-analytics)
#   - Walmart, Target, Newegg, Costco, B&H and more, via Google Shopping on the
#     "Real-Time Product Search" API (rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-product-search).
#     You must click "Subscribe" on that API's page (free plan: 100 requests/month).
RAPIDAPI_KEY=

# Best Buy official Products API key (free): https://developer.bestbuy.com
BESTBUY_API_KEY=

# Alternative to RapidAPI for Google Shopping: an OpenWeb Ninja key (openwebninja.com).
# If set, it's used instead of RAPIDAPI_KEY for the shopping source.
OPENWEBNINJA_API_KEY=

# Set to true to add a fake "Demo Store" source with deterministic prices.
# Handy for working on the UI without spending API quota. Never enable in production.
DEMO_MODE=false

# --- Tuning (defaults are sensible) ---
# How many top search results get a full multi-store price check immediately.
# Each one costs one Google Shopping request, so keep this low on free plans.
SHOPPING_OFFERS_PREFETCH=2
# How often favorited items are re-priced by the background worker.
REFRESH_INTERVAL_HOURS=6
